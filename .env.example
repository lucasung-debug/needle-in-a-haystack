# needle-in-a-haystack skill - BYOK placeholders only
# Copy to .env only if your runtime loads it. Leave blanks for free fallback behavior.

# Deep verify/synthesize (cost-gated)
OPENROUTER_API_KEY=

# Web search backends
BRAVE_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=

# X / Twitter
XAI_API_KEY=

# YouTube metadata and transcripts
YOUTUBE_API_KEY=

# Korean web / blog / cafe
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# TikTok / Instagram / Threads / Pinterest
SCRAPECREATORS_API_KEY=

# Whisper transcription for caption-less video
GROQ_API_KEY=

# ── Research-data APIs (see sources.md) ─────────────────────────────────
# Most are FREE/KEYLESS; these optional keys only raise rate limits or unlock extras.

# Scholarly literature
OPENALEX_MAILTO=          # polite-pool email (optional, keyless without it)
CROSSREF_MAILTO=          # polite-pool email (optional, keyless without it)
SEMANTIC_SCHOLAR_API_KEY= # free key, higher rate limit
UNPAYWALL_EMAIL=          # required param for Unpaywall OA lookups
CORE_API_KEY=             # free key, OA full-text aggregator

# Medicine / clinical / life sciences
NCBI_API_KEY=             # free key, PubMed/E-utilities 3->10 req/s
OPENFDA_API_KEY=          # free key, higher OpenFDA limit

# Engineering / patents
EPO_OPS_KEY=              # free registration, European patents
EPO_OPS_SECRET=
LENS_API_TOKEN=           # free tier, scholarly + patents

# Law / legislation / regulation
COURTLISTENER_API_TOKEN=  # free token from profile; many endpoints open without it
GOVINFO_API_KEY=          # free api.data.gov key (US bills, laws, CFR)

# Finance / filings / economics
SEC_EDGAR_USER_AGENT=     # required "Name email" User-Agent for SEC EDGAR (keyless otherwise)
FRED_API_KEY=             # free key, Federal Reserve economic time series

# Geospatial / earth observation
NASA_API_KEY=             # free key; DEMO_KEY works for trials at a lower rate
CDSE_CLIENT_ID=           # free Copernicus Data Space OAuth client (Sentinel imagery)
CDSE_CLIENT_SECRET=

# News / media archives
GUARDIAN_API_KEY=         # free developer key, Guardian/Observer full text

# Paid indexes (consent-gated; free fallbacks exist via OpenAlex/PubMed/arXiv)
SCOPUS_API_KEY=
WOS_API_KEY=
IEEE_API_KEY=
COCHRANE_API_KEY=
